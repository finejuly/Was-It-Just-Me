{
  "name": "was-it-just-me",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Privacy-preserving neighborhood signal map — \"Was It Just Me?\"",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:core": "esbuild src/core/bridge.ts --bundle --format=iife --global-name=WIJM --platform=neutral --target=es2020 --outfile=native/WIJMCore/Sources/WIJMCore/Resources/wijm-core.js",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
