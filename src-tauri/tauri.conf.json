{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Was It Just Me",
  "version": "0.0.1",
  "identifier": "ai.cochlear.wasitjustme",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Was It Just Me?",
        "label": "main",
        "width": 1000,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "SocialNetworking",
    "shortDescription": "See whether anyone nearby noticed something too.",
    "longDescription": "A privacy-preserving neighborhood signal map. Send a low-friction anonymous \"I noticed something\" signal; locations are intentionally randomized so no single sender's true location can be inferred."
  },
  "plugins": {
    "global-shortcut": {}
  }
}
